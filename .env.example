# Copy this file to ".env.local" (for your computer) or add these
# in Vercel > Project > Settings > Environment Variables.
# Never put your real key in GitHub.

# Your Claude API key from https://console.anthropic.com  (optional)
# If you leave it empty, the assistant uses simple built-in FAQ answers.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-haiku-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5
